# Copy to .env (never commit .env)
UPSTOX_ACCESS_TOKEN=        # daily token from Upstox login flow (expires ~3:30 AM IST next day)
ANTHROPIC_API_KEY=          # optional, for the AI analyst agent
TELEGRAM_BOT_TOKEN=         # optional, alerts (from @BotFather)
TELEGRAM_CHAT_ID=           # optional, alerts
KOTAK_CONSUMER_KEY=         # optional, Kotak Neo backup data
KOTAK_MOBILE=               # +91XXXXXXXXXX
KOTAK_UCC=                  # Kotak client code
KOTAK_MPIN=
KOTAK_TOTP_SECRET=          # optional; otherwise you type the TOTP at start-up
