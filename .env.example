# Copy to .env and fill in (it is git-ignored; never commit it).
# The bot reads it at start-up; your real environment variables take priority.
# Recommended: Upstox Analytics Token (developer portal -> My Apps -> Analytics -> Generate Token).
# Valid 1 year, read-only (cannot place orders), no daily login needed.
UPSTOX_ACCESS_TOKEN=
# Alternative (daily browser login): app keys with redirect http://127.0.0.1:5055/callback
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
ANTHROPIC_API_KEY=          # optional, for the AI analyst agent
TELEGRAM_BOT_TOKEN=         # optional, alerts (from @BotFather)
TELEGRAM_CHAT_ID=           # optional, alerts
KOTAK_CONSUMER_KEY=         # optional, Kotak Neo backup data
KOTAK_MOBILE=               # +91XXXXXXXXXX
KOTAK_UCC=                  # Kotak client code
KOTAK_MPIN=
KOTAK_TOTP_SECRET=          # optional; otherwise you type the TOTP at start-up
